# Climate AI Environment Configuration
# Optional: Set your port (default is 5000)
PORT=5000

# Optional Live Weather API Keys:
# The app works 100% offline using the built-in ML models and synthetic/local datasets.
# If you want live external weather data, you can optionally provide an OpenWeatherMap API key:
OPENWEATHER_API_KEY=your_openweathermap_api_key_here
