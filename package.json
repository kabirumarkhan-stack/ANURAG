{
  "name": "climate-ai",
  "version": "1.0.0",
  "description": "Climate AI — AI-Based Temperature Prediction & 7-Day Weather Forecaster for Environmental Monitoring",
  "main": "src/server.ts",
  "scripts": {
    "start": "ts-node src/server.ts",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "py:train": "python ml/train_models_cli.py",
    "py:server": "python server.py",
    "build": "tsc"
  },
  "keywords": [
    "climate-ai",
    "weather-forecast",
    "temperature-prediction",
    "machine-learning",
    "environmental-studies"
  ],
  "author": "Climate AI Team",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
